@baseUrl = http://127.0.0.1:5080

### Native library and worker readiness (503 when unavailable)
GET {{baseUrl}}/health/ready
@accountId = 11111111-1111-1111-1111-111111111111
@targetId = 22222222-2222-2222-2222-222222222222
@destinationId = 33333333-3333-3333-3333-333333333333
@id = 44444444-4444-4444-4444-444444444444
@from = 2026-11-07T00:00:00Z
@to = 2026-11-08T00:00:00Z

### GET accounts
GET {{baseUrl}}/api/accounts?page=1&pageSize=25&search=Example

### GET accounts
GET {{baseUrl}}/api/accounts/{{id}}

### POST accounts
POST {{baseUrl}}/api/accounts
Content-Type: application/json

{
  "name": "Example accounts",
  "enabled": true,
  "settings": {
    "apiId": 12345,
    "apiHash": "0123456789abcdef0123456789abcdef",
    "phone": "+886912345678"
  }
}

### PUT accounts
PUT {{baseUrl}}/api/accounts/{{id}}
Content-Type: application/json

{
  "name": "Example accounts",
  "enabled": true,
  "settings": {
    "apiId": 12345,
    "apiHash": "0123456789abcdef0123456789abcdef",
    "phone": "+886912345678"
  },
  "revision": 1
}

### DELETE accounts
DELETE {{baseUrl}}/api/accounts/{{id}}?revision=1

### GET targets
GET {{baseUrl}}/api/targets?page=1&pageSize=25&search=Example

### GET targets
GET {{baseUrl}}/api/targets/{{id}}

### POST targets
POST {{baseUrl}}/api/targets
Content-Type: application/json

{
  "name": "Example targets",
  "enabled": true,
  "settings": {
    "accountId": "{{accountId}}",
    "identifier": "@alice",
    "refreshSeconds": 30
