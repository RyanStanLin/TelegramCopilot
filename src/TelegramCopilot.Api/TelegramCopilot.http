Content-Type: application/json

{
  "name": "Example rules",
  "enabled": true,
  "settings": {
    "destinationId": "{{destinationId}}",
    "event": "Offline",
    "targetId": "{{targetId}}",
    "title": "{NAME}",
    "body": "Online for {TIME_OF_ONLINE}",
    "subtitle": "Presence",
    "group": "{NAME}",
    "parameters": {
      "sound": "bell"
    }
  }
}

