PUT {{baseUrl}}/api/targets/{{id}}
Content-Type: application/json

{
  "name": "Example targets",
  "enabled": true,
  "settings": {
    "accountId": "{{accountId}}",
    "identifier": "@alice",
    "refreshSeconds": 30
  },
  "revision": 1
}

### DELETE targets
DELETE {{baseUrl}}/api/targets/{{id}}?revision=1

